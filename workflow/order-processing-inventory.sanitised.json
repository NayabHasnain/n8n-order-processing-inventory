    {
      "parameters": {
        "jsCode": "return $input.all().map((inputItem) => {\n  const order = inputItem.json;\n\n  try {\n    const parsedItems = JSON.parse(order.items_json);\n\n    if (!Array.isArray(parsedItems) || parsedItems.length === 0) {\n      return {\n        json: {\n          ...order,\n          items: [],\n          item_count: 0,\n          valid_order: false,\n          validation_error: 'The order must contain at least one item.'\n        }\n      };\n    }\n\n    const items = parsedItems.map((item) => ({\n      sku: String(item?.sku ?? '').trim().toUpperCase(),\n      name: String(item?.name ?? '').trim(),\n      quantity: Number(item?.quantity)\n    }));\n\n    const invalidItem = items.find((item) =>\n      item.sku === '' ||\n      item.name === '' ||\n      !Number.isInteger(item.quantity) ||\n      item.quantity < 1\n    );\n\n    return {\n      json: {\n        ...order,\n        items,\n        item_count: items.length,\n        valid_order: !invalidItem,\n        validation_error: invalidItem\n          ? 'Every item requires a SKU, name and positive whole-number quantity.'\n          : ''\n      }\n    };\n  } catch (error) {\n    return {\n      json: {\n        ...order,\n        items: [],\n        item_count: 0,\n        valid_order: false,\n        validation_error: 'Order items must contain valid JSON.'\n      }\n    };\n  }\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
