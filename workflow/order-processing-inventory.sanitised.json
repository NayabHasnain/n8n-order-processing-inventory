    {
      "parameters": {
        "jsCode": "const lines = $input.all().map(item => item.json);\n\nconst orderTotal = Math.round(\n  lines.reduce((sum, line) => sum + Number(line.line_total || 0), 0) * 100\n) / 100;\n\nreturn [{\n  json: {\n    order_reference: lines[0]?.order_reference ?? '',\n    customer_name: lines[0]?.customer_name ?? '',\n    customer_email: lines[0]?.customer_email ?? '',\n    delivery_postcode: lines[0]?.delivery_postcode ?? '',\n    shipping_method: lines[0]?.shipping_method ?? '',\n    customer_notes: lines[0]?.customer_notes ?? '',\n    received_at: lines[0]?.received_at ?? '',\n    item_count: lines.length,\n    order_total: orderTotal,\n    all_stock_sufficient: lines.every(\n      line => line.stock_sufficient === true\n    ),\n    low_stock_after_order: lines.some(\n      line => Number(line.remaining_stock) <= Number(line.reorder_level)\n    ),\n    lines\n  }\n}];"
      },
